+  assert.equal(f.gate.snapshot().attempts.length, 0);
+  f.gate.close();
+}
+
+test('COST-01 missing approval and live endpoint fail before HTTP', async () => {
+  const f = fixture();
+  await assert.rejects(f.gate.request(f.request), /APPROVAL_MISSING/);
